{
  "name": "zemen-grid",
  "version": "2.5.0",
  "description": "Two calm, always-on-top Ethiopian calendar desktop widgets.",
  "main": "electron/main.js",
  "author": "Zemen Grid",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node --check electron/main.js && node --check electron/preload.js && node --check src/calendar.js && node --check src/controller.js && node --check src/grid-widget.js && node --check src/clock-widget.js && node --check src/note.js",
    "test": "node --test tests/calendar.test.js tests/renderer.test.js",
    "verify": "npm run check && npm test",
    "build:windows": "electron-builder --win nsis --x64",
    "build:portable": "electron-builder --win portable --x64",
    "publish:windows": "electron-builder --win nsis --x64 --publish always",
    "build:linux": "electron-builder --linux AppImage --x64"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "jsdom": "29.0.1"
  },
  "build": {
    "appId": "com.zemengrid.desktop",
    "productName": "Zemen Grid",
    "asar": true,
    "files": [
      "index.html",
      "grid.html",
      "clock.html",
      "note.html",
      "styles.css",
      "widget.css",
      "src/**/*",
      "electron/**/*",
      "assets/**/*",
      "README.md",
      "LICENSE"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Zemen-Grid-${version}-Setup-${arch}.${ext}",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "yikunoamlak",
      "repo": "zemen-grid",
      "releaseType": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "Zemen-Grid-${version}-${arch}.${ext}",
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
